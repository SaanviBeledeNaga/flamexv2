# FlameX Environment Configuration

# Application
PROJECT_NAME="FlameX"
ENV="development"
LOG_LEVEL="INFO"

# Backend Server
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database
# PostGIS Connection (for Docker / Production Postgres)
# DATABASE_URL="postgresql://flamex_user:flamex_pass@localhost:5432/flamex_db"
# SQLite Connection (for lightweight local execution without Postgres)
DATABASE_URL="sqlite:///./flamex.db"

# Data Sources & APIs
FIRMS_API_KEY=""
SENTINEL_HUB_CLIENT_ID=""
SENTINEL_HUB_CLIENT_SECRET=""

# Feature Engineering Parameters
INDUSTRIAL_PROXIMITY_RADIUS=1000  # meters
FOREST_PROXIMITY_RADIUS=2000      # meters
PERSISTENCE_TIME_WINDOW_DAYS=7
ANOMALY_ZSCORE_THRESHOLD=2.5
